msgid "SORT_WARNING_SETTINGS"
msgstr "Open Settings"

# "dirmemo" and "dirmemo2.lst" refer to the sorting file Flipnote uses and should not be translated.
msgid "SORT_WARNING_TOO_MANY_DIRMEMO"
msgstr "You can't organize when there is more than one dirmemo file. Try loading less subdirectories."

msgid "SORT_WARNING_TOO_MANY_FLIPNOTES"
msgstr "You have more than 100 Flipnotes in this folder; Flipnote Studio will ignore any Flipnote past 100. Please move some Flipnotes."

msgid "SORT_WARNING_WRONG_SORTING_MODE"
msgstr "You need to turn off Sort Flipnotes Alphabetically by Filename in settings before you can sort Flipnotes."

msgid "SORT_XBOX_CONTROLLER"
